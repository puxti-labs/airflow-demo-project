# Airflow demo environment — copy to .env and fill in values
# Never commit real credentials.

# GCP
AIRFLOW_VAR_GCP_PROJECT=clariva-data-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Salesforce (stored as Airflow Variables — alternatively use Airflow Connections)
AIRFLOW_VAR_SALESFORCE_INSTANCE_URL=https://clariva.my.salesforce.com
# AIRFLOW_CONN_SALESFORCE_DEFAULT is set via Airflow UI or CLI:
# airflow connections add salesforce_default \
#   --conn-type http \
#   --conn-host https://clariva.my.salesforce.com \
#   --conn-extra '{"login": "user@clariva.io", "password": "...", "security_token": "..."}'

# Stripe
AIRFLOW_VAR_STRIPE_API_KEY=sk_live_...

# dbt
AIRFLOW_VAR_DBT_PROJECT_DIR=/opt/dbt/clariva
AIRFLOW_VAR_DBT_PROFILES_DIR=/opt/dbt/profiles
AIRFLOW_VAR_DBT_TARGET=prod

# Incremental extraction window (days)
AIRFLOW_VAR_SALESFORCE_INCREMENTAL_DAYS=3
